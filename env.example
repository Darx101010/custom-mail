# قاعدة البيانات (Supabase: Transaction pooler في DATABASE_URL و Direct في DIRECT_URL)
DATABASE_URL=
DIRECT_URL=

# Auth.js + Google OAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# الأدمن (الحساب الأول يُنشأ عند seed ويُجبر على تغيير كلمة المرور عند أول دخول)
ADMIN_JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Darx

# أسرار أخرى (كل واحد قيمة مختلفة: openssl rand -base64 32)
INBOUND_WEBHOOK_SECRET=
KEY_PEPPER=
CRON_SECRET=

MAIL_DOMAIN=yourdomain.com

# اختياري (مُوصى به في الإنتاج): Upstash Redis لتحديد المعدل
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
